# Preserve exact byte-for-byte binary content for all benchmark data assets
# Prevents Git from altering line endings (CRLF/LF) and preserves frozen cryptographic SHA-256 digests
data/*.json -text
data/**/*.json -text
pilot/**/*.json -text
figures/*.png binary

# Normalized text files
*.py text
*.md text
*.txt text
.gitignore text
.gitattributes text
LICENSE text
